{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIMO Running reads your running, walking and hiking workouts plus health data such as heart rate and pace to analyze your activity."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランニング・ウォーキング・ハイキングのワークアウト記録と、心拍数・ペースなどの健康データを読み取り、アクティビティを分析します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "러닝, 걷기, 하이킹 운동 기록과 심박수, 페이스 등 건강 데이터를 읽어 활동을 분석합니다."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIMO Running doesn't write any health data. All workouts are analyzed from the data already in the Health app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIMO Runningは健康データを書き込みません。すべてのワークアウト記録は、ヘルスケアにあるデータを読み取って分析します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미모러닝은 건강 데이터를 직접 기록하지 않습니다. 모든 운동 기록은 기존 건강 앱의 데이터를 읽어 분석합니다."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves your running share cards to your photo library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランのシェアカードを写真ライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "러닝 공유 카드를 사진첩에 저장합니다."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves running share cards and videos to your photo library, and loads photos you choose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランのシェアカードや動画を写真ライブラリに保存したり、写真を読み込んだりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "러닝 공유 카드 및 영상을 사진첩에 저장하거나 사진을 불러옵니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
